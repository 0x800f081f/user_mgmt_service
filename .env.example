# -----------------------------------------------------------------------------
# Datenbank / Spring Datasource
# Wird sowohl vom Service "db" (POSTGRES_USER / POSTGRES_PASSWORD) als auch
# vom Spring-Boot-Backend verwendet.
# -----------------------------------------------------------------------------
# Host = Service-Name "db" aus docker-compose.yml, DB-Name = "postgres"
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Hibernate Schema-Handling: none | validate | update | create | create-drop
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# -----------------------------------------------------------------------------
# JWT (siehe core/security/helpers/JwtProperties.java)
# -----------------------------------------------------------------------------
JWT_ISSUER=example.ch

# Base64-kodierter HMAC-Schluessel, mindestens 256 Bit (32 Byte) fuer HS256.
# Erzeugen z. B. mit: openssl rand -base64 32
JWT_SECRET=change-me-base64-encoded-256-bit-secret

# Gueltigkeitsdauer des Tokens in Millisekunden (hier: 24 Stunden)
JWT_EXPIRATION_MILLIS=86400000

# -----------------------------------------------------------------------------
# Traefik / TLS (ACME - Let's Encrypt)
# Wird in docker-compose.yml als
# TRAEFIK_CERTIFICATESRESOLVERS_PROXY_ACME_EMAIL gesetzt.
# -----------------------------------------------------------------------------
TRAEFIK_EMAIL=admin@example.ch

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# Wird bereits zur Build-Zeit als Build-Arg benoetigt.
# Optional - Default in docker-compose.yml: https://example.ch
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://example.ch

